---
layout: base.njk
permalink: /blog.html
pagina: blog
---
    <section class="page-header">
      <div class="container">
        <span class="eyebrow">{{ blog.cabecalho.eyebrow }}</span>
        <h1>{{ blog.cabecalho.titulo }}</h1>
        <p class="lede">{{ blog.cabecalho.lede }}</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="grid grid-3" id="blog-list">
          {%- for post in collections.posts %}
          <article class="card post-card">
            <span class="date">{{ post.data.date | dataPtBr }}</span>
            <h3>{{ post.data.title }}</h3>
            <p>{{ post.data.excerpt }}</p>
            {#- O destino ainda não existe: não há páginas de artigo individuais.
                Mantido igual ao site atual até decidir entre criar as páginas
                ou remover o link. #}
            <a class="read-more" href="#">{{ blog.texto_ler_artigo }}</a>
          </article>
          {%- endfor %}
        </div>
      </div>
    </section>

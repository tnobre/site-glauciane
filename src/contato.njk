---
layout: base.njk
permalink: /contato.html
pagina: contato
---
    <section class="page-header">
      <div class="container">
        <span class="eyebrow">{{ contato.cabecalho.eyebrow }}</span>
        <h1>{{ contato.cabecalho.titulo }}</h1>
        <p class="lede">{{ contato.cabecalho.lede }}</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="grid grid-2" style="align-items: start;">

          <div class="card">
            <div class="form-success" role="status">{{ contato.mensagem_sucesso }}</div>
            <div class="form-falha" role="alert">{{ contato.mensagem_erro }}</div>
            {#- data-netlify: a Netlify detecta o formulário no build e passa a
                receber os envios. netlify-honeypot: campo-isca invisível que
                barra robôs sem precisar de captcha. #}
            <form id="contact-form" name="contato" method="POST" data-netlify="true" netlify-honeypot="bot-field" novalidate>
              <input type="hidden" name="form-name" value="contato" />
              <p hidden aria-hidden="true">
                <label>Não preencha este campo: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
              </p>
              <div class="form-field">
                <label for="tipo">{{ contato.formulario.rotulo_tipo }}</label>
                <select id="tipo" name="tipo" data-required>
                  <option value="">{{ contato.formulario.opcao_vazia }}</option>
                  {%- for opcao in contato.formulario.opcoes_tipo %}
                  <option value="{{ opcao.valor }}">{{ opcao.texto }}</option>
                  {%- endfor %}
                </select>
                <span class="form-error">{{ contato.formulario.erro_tipo }}</span>
              </div>

              <div class="form-field">
                <label for="nome">{{ contato.formulario.rotulo_nome }}</label>
                <input type="text" id="nome" name="nome" data-required autocomplete="name" />
                <span class="form-error">{{ contato.formulario.erro_nome }}</span>
              </div>

              <div class="form-field">
                <label for="email">{{ contato.formulario.rotulo_email }}</label>
                <input type="email" id="email" name="email" data-required autocomplete="email" />
                <span class="form-error">{{ contato.formulario.erro_email }}</span>
              </div>

              <div class="form-field">
                <label for="telefone">{{ contato.formulario.rotulo_telefone }}</label>
                <input type="tel" id="telefone" name="telefone" autocomplete="tel" />
              </div>

              <div class="form-field">
                <label for="mensagem">{{ contato.formulario.rotulo_mensagem }}</label>
                <textarea id="mensagem" name="mensagem" data-required placeholder="{{ contato.formulario.placeholder_mensagem }}"></textarea>
                <span class="form-error">{{ contato.formulario.erro_mensagem }}</span>
              </div>

              <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">{{ contato.formulario.botao_enviar }}</button>
            </form>
          </div>

          <div>
            <div class="contact-info" style="margin-bottom: var(--space-3);">
              <div class="item">
                <span class="icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l9 6 9-6M4 4h16a1 1 0 011 1v14a1 1 0 01-1 1H4a1 1 0 01-1-1V5a1 1 0 011-1z"/></svg>
                </span>
                <span>{{ site.email }}</span>
              </div>
              <div class="item">
                <span class="icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.36 1.9.68 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.9.32 1.85.55 2.81.68A2 2 0 0122 16.92z"/></svg>
                </span>
                <span>{{ site.telefone_exibicao }}</span>
              </div>
              <div class="item">
                <span class="icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </span>
                <span>{{ contato.atendimento }}</span>
              </div>
            </div>

            <a href="{{ site.whatsapp_url }}" target="_blank" rel="noopener" class="whatsapp-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1s-.7.9-.9 1.1-.4.2-.7.1a8 8 0 01-2.3-1.4 8.6 8.6 0 01-1.6-2c-.2-.3 0-.5.1-.6l.4-.5.2-.4c.1-.1.1-.3 0-.4-.1-.1-.7-1.7-1-2.3-.2-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 00-.8.4 3.4 3.4 0 00-1 2.5c0 1.5 1 2.9 1.2 3.1.1.2 2 3.1 5 4.3a17 17 0 001.7.6 4 4 0 001.9.1c.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.1-1.4z"/><path d="M12 2a10 10 0 00-8.5 15.2L2 22l4.9-1.3A10 10 0 1012 2zm0 18a8 8 0 01-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1112 20z"/></svg>
              {{ contato.botao_whatsapp }}
            </a>

            <p style="margin-top: var(--space-3); font-size: var(--fs-caption); color: var(--color-ink-soft);">
              {{ contato.aviso_privacidade_antes }}<a href="privacidade.html" style="color: var(--color-reform);">{{ contato.aviso_privacidade_link }}</a>{{ contato.aviso_privacidade_depois }}
            </p>
          </div>
        </div>
      </div>
    </section>

{# ============================================================
   Ícones dos cards.

   Ficam aqui, e não no CMS, porque são SVG — a Glauciane escolhe
   pelo nome no painel ("predio", "raio"...) sem ver código.
   Para acrescentar um ícone novo, basta adicionar um bloco aqui
   e o mesmo nome na lista de opções em src/admin/config.yml.
   ============================================================ #}
{% macro icone(nome) -%}
{%- if nome == "predio" -%}
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 9h1M14 9h1M9 13h1M14 13h1"/></svg>
{%- elif nome == "loja" -%}
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21V8a2 2 0 012-2h12a2 2 0 012 2v13M9 21v-6h6v6M9 11h.01M15 11h.01"/></svg>
{%- elif nome == "documento" -%}
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="M8 4v16M4 9h4"/></svg>
{%- elif nome == "balanca" -%}
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18M5 8l7-5 7 5M5 8v10a1 1 0 001 1h12a1 1 0 001-1V8"/></svg>
{%- elif nome == "calendario" -%}
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v3M16 4v3"/></svg>
{%- elif nome == "raio" -%}
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/></svg>
{%- endif -%}
{%- endmacro %}
